---
import type { ThemeRow } from '@domain/post-collection';
import PostRow from './PostRow.astro';

interface Props {
	rows: ThemeRow[];
	priority?: boolean; // ? `true` si la grille est la vue affichée au chargement. `false` pour un panneau masqué.
}

const { rows, priority = true } = Astro.props;
---

<div class="post-grid">
	{rows.map((row, i) => <PostRow row={row} priority={priority && i === 0} />)}
</div>

<style>
	.post-grid {
		display: flex;
		flex-direction: column;
	}
</style>
