---
import type { ThemeRow } from '@domain/post-collection';
import PostRow from './PostRow.astro';

interface Props {
	rows: ThemeRow[];
}

const { rows } = Astro.props;
---

<div class="post-grid">
	{rows.map((row, i) => <PostRow row={row} priority={i === 0} />)}
</div>

<style>
	.post-grid {
		display: flex;
		flex-direction: column;
	}
</style>
