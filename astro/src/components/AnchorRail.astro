---
import type { RailItem } from "@/ui/nav/rail";
import type { GalleryView } from "@/ui/view/view-preference";

interface Props {
  items: RailItem[];
  ariaLabel: string; // ? Nom accessible du repère de navigation.
  view: GalleryView; // ? Vue à laquelle ce rail appartient : il n'est visible que dans celle-ci.

  /**
   * ? Préfixe des `id` de section suivis par le scrollspy (« category- », « month- »).
   * ! Chaque rail n'observe QUE ses sections : les deux vues coexistent dans le DOM.
   */
  prefix: string;
}

const { items, ariaLabel, view, prefix } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="anchor-rail" aria-label={ariaLabel} data-rail data-rail-view={view} data-rail-prefix={prefix}>
      {/**
         * ? Bascule du sens de lecture de LA VUE : les repères du rail, les sections qu'il indexe et les posts de chacune.
         * * Contrairement à `ViewToggle`, son nom accessible NE CHANGE PAS (l'icône seule dit l'état) : `aria-pressed`
         * * est donc ici l'attribut correct au sens de l'ARIA APG.
         * ! Une bascule n'a de sens qu'avec JS : rendu `hidden`, il n'est révélé qu'une fois câblé par l'îlot ci-dessous.
         */}
      <button
        type="button"
        class="anchor-rail__order"
        data-rail-order-toggle
        aria-pressed="false"
        aria-label="Inverser l'ordre de lecture de la galerie"
        hidden
      >
        <span class="anchor-rail__order-icon" aria-hidden="true" />
        <span class="anchor-rail__order-hint" aria-hidden="true">
          inverser l'ordre
        </span>
      </button>
      <ul>
        {items.map((item: RailItem) => (
          <li>
            <a
              class="anchor-rail__link"
              href={`#${item.anchor}`}
              data-rail-anchor={item.anchor}
              aria-label={item.label}
            >
              <span class="anchor-rail__dot" aria-hidden="true" />
              <span class="anchor-rail__code">{item.code}</span>
              <span class="anchor-rail__full" aria-hidden="true">
                {item.full}
              </span>
            </a>
          </li>
        ))}
      </ul>
      {/* ? Le réagencement est purement visuel : on l'annonce aux lecteurs d'écran. */}
      <p class="visually-hidden" data-rail-order-status role="status" aria-live="polite" />
    </nav>
  )
}

<script>
  import {
    READING_ORDER_STORAGE_KEY,
    mirrored,
    readingOrderAnnouncement,
    readingOrdersStorageValue,
    toggleReadingOrder,
    type ReadingOrder,
    type ReadingOrders,
  } from "@/ui/view/reading-order";

  // ? État d'une bascule : `aria-pressed` EST la source de vérité — le script pré-peinture de Gallery l'a déjà posé si un choix était stocké.
  function currentOrder(toggle: Element | null | undefined): ReadingOrder {
    return toggle?.getAttribute("aria-pressed") === "true" ? "reversed" : "natural";
  }

  // ? Persistance des DEUX vues d'un coup, relue depuis le DOM : aucun état à tenir en double côté script.
  function persistOrders(): void {
    const orders: ReadingOrders = { theme: "natural", date: "natural" };
    for (const rail of document.querySelectorAll<HTMLElement>("[data-rail]")) {
      const view = rail.dataset.railView;
      if (view === "theme" || view === "date") {
        orders[view] = currentOrder(rail.querySelector("[data-rail-order-toggle]"));
      }
    }
    try {
      localStorage.setItem(READING_ORDER_STORAGE_KEY, readingOrdersStorageValue(orders));
    } catch {
      /* //? stockage indisponible : la bascule reste effective pour la session */
    }
  }

  // ? Bascule du sens de lecture (amélioration progressive) : un rail = un bouton, qui ne réagence QUE sa propre vue.
  for (const rail of document.querySelectorAll<HTMLElement>("[data-rail]")) {
    const button = rail.querySelector<HTMLButtonElement>("[data-rail-order-toggle]");
    const railList = rail.querySelector("ul");
    const status = rail.querySelector<HTMLElement>("[data-rail-order-status]");
    if (!button || !railList) continue;

    // ? Le panneau de galerie de CETTE vue : `data-rail-view` et `data-view-panel` portent la même clé (« theme » / « date »).
    const panel = document.querySelector(`[data-view-panel="${rail.dataset.railView ?? ""}"]`);
    const sections = Array.from(panel?.querySelectorAll(`[aria-labelledby^="${rail.dataset.railPrefix ?? ""}"]`) ?? []);

    /**
     * ? Le sens de lecture s'applique à TOUS les niveaux de la vue, sinon le rail contredirait la galerie :
     * ?   1. les repères du rail ; 2. les sections du flux (rubriques ou mois) ; 3. les posts de chaque section.
     * ? Seuls les PARENTS sont retenus : chaque bascule miroite leurs enfants du moment, l'inversion étant une involution
     * ? (cf. `mirrored`). Le DOM est donc l'unique état — y compris quand le script pré-peinture l'a déjà inversé au chargement.
     */
    const levels: Element[] = [railList];

    const flow = sections[0]?.parentElement;
    if (flow) {
      levels.push(flow);
    }

    for (const section of sections) {
      const track = section.querySelector("[data-post-track]");
      if (track) {
        levels.push(track);
      }
    }

    // ? Le repère imposé par la bascule ne tient que jusqu'au prochain geste du lecteur : molette, doigt,
    // ? clavier ou clic sur un repère rendent la main au scrollspy, qui redevient seul juge du repère courant.
    const releaseForced = () => {
      delete rail.dataset.railForced;
    };
    for (const gesture of ["wheel", "touchmove", "keydown"]) {
      window.addEventListener(gesture, releaseForced, { passive: true });
    }
    railList.addEventListener("click", releaseForced);

    // ? Le bouton n'a de sens qu'avec JS : il n'apparaît qu'une fois câblé.
    button.hidden = false;

    button.addEventListener("click", () => {
      const next = toggleReadingOrder(currentOrder(button));

      // ? On retient la PLACE du repère courant (son index), pas la section qu'il désigne : après inversion,
      // ? c'est le repère qui occupe cette même place — donc son symétrique — qui prend la main.
      const activeIndex = Array.from(rail.querySelectorAll("[data-rail-anchor]")).findIndex(
        (marker) => marker.getAttribute("aria-current") === "true"
      );

      button.setAttribute("aria-pressed", next === "reversed" ? "true" : "false");

      // ! On réordonne le DOM (et non un `flex-direction: column-reverse` / `order`) : l'ordre de tabulation doit
      // ! suivre l'ordre visuel (WCAG 2.4.3). `append` DÉPLACE les nœuds déjà en place, sans les recréer, donc
      // ! l'`aria-current` du scrollspy, les visuels déjà chargés, les écouteurs de la modale et le focus clavier
      // ! en cours survivent à la bascule.
      for (const parent of levels) {
        parent.append(...mirrored(Array.from(parent.children)));
      }

      /**
       * ? Le repère de MÊME INDEX est IMPOSÉ, puis sa section amenée en position de lecture.
       * ! `dataset.railForced` fait taire le scrollspy jusqu'au prochain geste du lecteur : en bas du document,
       * ! plus aucun défilement ne peut amener la section visée dans la bande active (le défilement est borné),
       * ! et l'observateur, laissé libre, désignerait alors une autre section — l'index forcé sauterait.
       */
      const markersAfter = Array.from(rail.querySelectorAll("[data-rail-anchor]"));
      const target = activeIndex >= 0 ? markersAfter[activeIndex] : undefined;
      const targetHeading = document.getElementById(target?.getAttribute("data-rail-anchor") ?? "");
      if (target && targetHeading) {
        rail.dataset.railForced = "true";
        for (const marker of markersAfter) {
          marker.setAttribute("aria-current", marker === target ? "true" : "false");
        }
        targetHeading.scrollIntoView({ block: "start", behavior: "instant" });
      }

      if (status) {
        status.textContent = readingOrderAnnouncement(next);
      }
      persistOrders();
    });
  }

  // ? Scrollspy (amélioration progressive) : met en avant le repère visible.
  // ? Un seul script pour TOUS les rails de la page — il itère sur [data-rail] et cloisonne chacun à ses propres liens et à ses propres sections.
  for (const rail of document.querySelectorAll<HTMLElement>("[data-rail]")) {
    const prefix = rail.dataset.railPrefix ?? "";

    // ! Annotation, et non `new Map<string, Element>()` : le parser ESLint des blocs
    // ! <script> d'Astro rejette les arguments de type sur une expression `new`.
    const links: Map<string, Element> = new Map();
    for (const link of rail.querySelectorAll("[data-rail-anchor]")) {
      links.set(link.getAttribute("data-rail-anchor") ?? "", link);
    }

    // On observe les SECTIONS (elles pavent la page en continu → il y en a toujours
    // une dans la bande), pas les titres fins. Elles portent aria-labelledby="<prefix>…".
    const sections = document.querySelectorAll(`[aria-labelledby^="${prefix}"]`);

    if (!prefix || links.size === 0 || sections.length === 0) continue;

    const setActive = (anchor: string) => {
      for (const [key, link] of links) {
        link.setAttribute("aria-current", key === anchor ? "true" : "false");
      }
    };

    const anchorOf = (section: Element) => section.getAttribute("aria-labelledby") ?? "";

    // ? Par défaut : le premier repère est actif (haut de page), avant tout scroll.
    setActive(anchorOf(sections[0]));

    const observer = new IntersectionObserver(
      (entries) => {
        // ! Une bascule d'ordre a pu IMPOSER un repère (cf. `data-rail-forced`) : on ne le contredit pas.
        if (rail.dataset.railForced) return;
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(anchorOf(entry.target));
        }
      },
      // Bande active proche du haut du viewport : la section qui occupe le haut est « courante » (au tout début, c'est bien la première).
      { rootMargin: "-10% 0px -80% 0px", threshold: 0 }
    );
    for (const section of sections) observer.observe(section);
  }
</script>

<style>
  /* Rail vertical logé dans la gouttière gauche, sous la largeur max du contenu.
	   Masqué quand l'espace latéral est insuffisant (pour ne pas chevaucher). */
  .anchor-rail {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    left: 1.5rem;
    z-index: 10;
    display: none;
  }
  @media (min-width: 32rem) and (min-height: 16rem) {
    .anchor-rail {
      display: block;
    }
  }
  /* //? Un rail par vue : celui de la vue inactive sort du flux. Les sélecteurs sont
		? plus spécifiques que la media-query ci-dessus, qui reste donc sans effet sur lui.
		? Sans data-view (JS coupé), la vue par rubrique est celle qui s'affiche. */
  :root[data-view="date"] .anchor-rail[data-rail-view="theme"],
  :root:not([data-view="date"]) .anchor-rail[data-rail-view="date"] {
    display: none;
  }

  /*//? Bascule du sens de lecture : posée au-dessus du fil, alignée sur la colonne des pastilles. */
  .anchor-rail__order {
    display: flex;
    align-items: center;
    /*//? `flex-start` et non `center` : quand la consigne se déplie, la pastille grandit vers la DROITE
			? et l'icône ne bouge donc pas — elle reste dans l'axe des pastilles des repères. */
    justify-content: flex-start;
    margin: 0 0 0.15rem 0.25rem;
    padding: 0.3rem 0.5rem;
    min-width: 24px;
    min-height: 24px; /*//? Cible d'au moins 24 × 24 px (WCAG 2.5.8) : l'icône seule serait trop menue. */
    font-size: 0.72rem; /*//? Même échelle typographique que les repères : l'icône est dimensionnée en `em`. */
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  /*//! `display:flex` écrase la règle UA `[hidden] { display: none }` : sans ce rappel, le bouton
	    ! resterait visible (et inerte) sans JS. `display:none` l'ôte aussi de l'ordre de tabulation. */
  .anchor-rail__order[hidden] {
    display: none;
  }
  /*//? Déplié, la consigne déborde du rail et passe AU-DESSUS des vignettes : même pastille franchement
		  ? opaque que le libellé complet d'un repère (voir plus bas), pour la même raison — un voile laisserait
		  ? lire l'image à travers le texte, et le halo en --muted détache la pastille d'une vignette de même fond. */
  .anchor-rail__order:hover,
  .anchor-rail__order:focus-visible {
    color: var(--fg);
    background: var(--bg);
  }
  .anchor-rail__order[aria-pressed="true"] {
    color: var(--acc-text, var(--acc));
  }

  /*//? Consigne repliée par défaut, révélée en douceur au survol/focus — même mécanique que `.anchor-rail__full`.
		  ? Volontairement ATTÉNUÉE (--muted, qui tient 7,3:1 en sombre et 6,1:1 en clair) :
		  ? elle explique l'icône sans prétendre au même poids qu'un repère de navigation. */
  .anchor-rail__order-hint {
    max-width: 0;
    margin-left: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--muted);
    transition:
      max-width 0.3s ease,
      margin-left 0.3s ease,
      opacity 0.25s ease;
  }
  .anchor-rail__order:hover .anchor-rail__order-hint,
  .anchor-rail__order:focus-visible .anchor-rail__order-hint {
    max-width: 12rem;
    margin-left: 0.5rem;
    opacity: 1;
  }

  /* Icône tracée en CSS — ni emoji ni SVG externe (charte §9) : une flèche (hampe + pointe)
	   qui pivote d'un demi-tour quand l'ordre est inversé, donc l'état ne tient pas qu'à la couleur. */
  .anchor-rail__order-icon {
    position: relative;
    width: 6px;
    height: 0.8em;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 2px 100%;
    background-position: 50% 0;
    background-repeat: no-repeat;
    transition: transform 0.25s ease;
  }
  .anchor-rail__order-icon::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid currentColor;
  }
  .anchor-rail__order[aria-pressed="true"] .anchor-rail__order-icon {
    transform: rotate(180deg);
  }

  .anchor-rail ul {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.25rem 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    /* Fil vertical façon timeline. */
    border-left: 1px solid var(--border);
  }
  .anchor-rail__link {
    display: flex;
    align-items: center;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: var(--muted);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .anchor-rail__dot {
    width: 6px;
    height: 6px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
    flex: none;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease,
      background-color 0.2s ease;
  }
  /* //? Libellé complet : replié par défaut, révélé en douceur au survol/focus. */
  .anchor-rail__full {
    max-width: 0;
    margin-left: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.3s ease,
      margin-left 0.3s ease,
      opacity 0.25s ease;
  }
  .anchor-rail__link:hover .anchor-rail__full,
  .anchor-rail__link:focus-visible .anchor-rail__full {
    max-width: 16rem;
    margin-left: 0.5rem;
    opacity: 1;
  }
  /* //? Déplié, le libellé complet déborde du rail et passe AU-DESSUS des vignettes (le contenu fait 80vw centré, le
		? rail vit dans la gouttière). Le fond doit donc être franchement opaque : un voile laissait lire l'image à
		? travers le texte. `--bg` plutôt que `--panel`, qui n'est pas défini dans le chrome (seulement dans les modes
		? de post) et retombait sur un gris à 8 %. Le halo + l'ombre détachent la pastille du fond quand elle est posée
		? sur la page, de même couleur. */
  .anchor-rail__link:hover,
  .anchor-rail__link:focus-visible {
    color: var(--fg);
    background: var(--bg);
    /* Halo en --muted, pas en --border : une vignette en mode sombre a EXACTEMENT le
		   même fond que le chrome sombre (#120A07), donc un filet discret y disparaît,
		   ombre portée comprise. --muted tient 7,3:1 (sombre) et 6,1:1 (clair). */
    box-shadow:
      0 0 0 1px var(--muted),
      0 6px 18px rgb(0 0 0 / 0.28);
  }
  /* Le repère courant garde son accent au survol (la règle suit celle du hover,
	   à spécificité égale) : c'est --acc-text sur --bg, vérifié ≥ 4,5:1 dans les deux thèmes. */
  .anchor-rail__link[aria-current="true"] {
    color: var(--acc-text, var(--acc));
  }
  .anchor-rail__link[aria-current="true"] .anchor-rail__dot {
    opacity: 1;
    background: var(--acc);
    transform: scale(1.5);
  }
</style>
