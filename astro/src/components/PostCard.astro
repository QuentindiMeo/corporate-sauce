---
import { Image } from 'astro:assets';
import { isScheduledNow, PostPageViewModel, type PostViewModel } from '@/ui/view-model/post-view-model';

/*
 * ? Composant « bête » : il ne consomme qu'un view model (aucun import du domaine, aucune
 * ? règle métier appelée, aucun cast). Tout est préparé par `toPostViewModel`.
 */
interface Props {
	post: PostViewModel;
	priority?: boolean; // ? `true` pour le 1er écran (désactive le lazy-load, améliore le LCP).
	now?: Date; // ? Instant de référence pour « posté / à venir ». Injectable pour les tests ; sinon le build.
}

const { post, priority = false, now = new Date() } = Astro.props;

// ? Post encore à paraître : signalé par une pastille ET par le nom accessible du lien
// ? (charte §2 : le sens ne repose jamais sur la couleur seule).
// ! Cet état est le REPLI du rendu statique ; `initSchedule` le recalcule à l'heure du navigateur.
// ! Il est calculé ICI, et non porté par le view model, précisément parce qu'il dépend du temps.
const scheduled = isScheduledNow(post, now);

// ? Folder card (la « fard ») pour les carrousels : on empile jusqu'à 3 pages. La page 0 est de face.
const fardPages = post.pages.slice(0, 3);
---

<article
	class="post-card"
	data-mode={post.mode}
	data-dark={post.isDarkMode ? '' : undefined}
	data-fard={post.isCarousel ? '' : undefined}
	data-scheduled={scheduled ? '' : undefined}
	data-published-at={post.publishedAtIso}
	style={post.headerStyle}
>
	<a
		class="post-card__link"
		href={post.linkedInUrl}
		target="_blank"
		rel="noopener noreferrer"
		data-post-id={post.id}
		data-aria-base={post.ariaBase}
		aria-label={`${post.ariaBase} (${scheduled ? 'à venir' : 'posté'})`}
		aria-description={post.ariaDescription}
	>
		<p class="post-card__title"><span>{post.title}</span></p>
		{/* //? Toujours rendue : c'est CSS (via data-scheduled) qui l'affiche ou non, pour que
		      ? le contrôleur client n'ait qu'un attribut à basculer — sans insertion de DOM. */}
		<span class="post-card__scheduled">À venir</span>
		<div class="post-card__media">
			{
				post.isCarousel ? (
					<div class="fard">
						{fardPages.map((page: PostPageViewModel, i: number) => (
							<Image
								class={`fard__page fard__page--${i}`}
								src={page.image}
								alt={i === 0 ? page.alt : ''}
								widths={[280, 420, 560]}
								sizes="(max-width: 640px) 70vw, 220px"
								loading={priority && i === 0 ? 'eager' : 'lazy'}
							/>
						))}
						<span class="fard__badge">
							{post.pageCount} pages
						</span>
					</div>
				) : (
					<Image
						class="post-card__image"
						src={post.image}
						alt={post.imageAlt}
						widths={[360, 540, 720]}
						sizes="(max-width: 640px) 80vw, 260px"
						loading={priority ? 'eager' : 'lazy'}
					/>
				)
			}
		</div>
	</a>
</article>

<style>
	.post-card {
		position: relative;
		border-radius: 10px;
		overflow: hidden;
		/* Thème de couleur de la carte, dérivé du mode (attribut booléen data-dark) :
		   aligne le color-scheme sur le fond du post (clair par défaut, dark si sombre/liant). */
		color-scheme: light;
		background: var(--bg);
		/* Couleur du texte = --fg DU MODE (posé en inline par styleFromMode), pas
		   celui du chrome : sans ça, un titre pouvait tomber à ~1:1 (ex. crème sur
		   crème). Ainsi le contraste titre/fond reste ≥ 14:1 dans les 3 modes. */
		color: var(--fg);
		border: 1px solid var(--border);
		/* Animation progressive (charte) : profondeur au survol. */
		transition:
			transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.35s ease;
	}
	.post-card[data-dark] {
		color-scheme: dark;
	}
	.post-card:hover,
	.post-card:focus-within {
		transform: scale(1.06) rotate(-1.5deg);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
		z-index: 2;
	}
	.post-card__link {
		display: flex;
		flex-direction: column;
		aspect-ratio: 1 / 1;
		text-decoration: none;
		color: inherit;
	}
	.post-card__link:hover,
	.post-card__link:focus {
		text-decoration: revert;
	}
	.post-card__title {
		height: 16%;
		margin: 0;
		padding: 0 0.75rem;
		/* Centrage vertical + horizontal du titre dans la bande (1 ou 2 lignes). */
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-title, system-ui, sans-serif);
		font-weight: 700;
		font-size: 0.95rem;
		line-height: 1.2;
		text-wrap: balance;
		/* //? Au-dessus des pages du fard (z 1-3) et du badge (z 4) : en s'ouvrant,
		   l'éventail déborde vers le haut et passait PAR-DESSUS le titre. */
		position: relative;
		z-index: 5;
		/* Halo dans la couleur opposée au texte (--bg et --fg sont les deux pôles
		   du mode, posés en inline) : le titre reste lisible sur la page qui glisse
		   dessous, quel que soit le mode. */
		text-shadow:
			0 1px 2px var(--bg),
			0 0 6px var(--bg);
	}
	/* Le clamp 2 lignes vit sur l'enfant, sans interférer avec le centrage. */
	.post-card__title span {
		text-align: center;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	/* Le conteneur remplit exactement l'espace disponible sous le titre (le lien
	   reste carré). Il porte le rognage. */
	.post-card__media {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		/* Grille 1×1 : permet de positionner l'image surdimensionnée et de laisser
		   déborder ce qui dépasse (rogné par overflow). */
		display: grid;
	}
	/*
	 * LE TRICK : on garde le ratio imposé (aspect-ratio) SUR L'IMAGE tout en la
	 * faisant COUVRIR le conteneur. Impossible sur un <img> dimensionné par flex
	 * (une taille définie annule aspect-ratio). Ici l'image est en `auto` avec
	 * `min-width/min-height: 100 %` : elle grandit jusqu'à couvrir les deux axes
	 * du conteneur en conservant son ratio 1080/1360 ; le surplus déborde et est
	 * rogné. `object-fit: cover` garantit des pixels non déformés.
	 */
	.post-card__image {
		grid-area: 1 / 1;
		place-self: start center; /* ancre en haut → on voit le haut de l'image */
		width: auto;
		height: auto;
		min-width: 100%;
		min-height: 100%;
		aspect-ratio: 1080 / 1360;
		object-position: top;
	}

	/* ── « Fard » : folder card, 3 pages pliées l'une sur l'autre (post carrousel) ──────────── */
	.post-card[data-fard] .post-card__media {
		/* //? Laisse les pages du dessous dépasser légèrement (rogné au bord de la carte). */
		overflow: visible;
	}
	.fard {
		position: relative;
		width: 100%;
		height: 100%;
	}
	.fard__page {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 80%;
		height: 88%;
		object-fit: cover;
		object-position: top;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--bg);
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.28);
		transform-origin: 50% 100%; /* //? Éventail depuis le bas : les hauts des pages arrière dépassent. */
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.fard__page--0 {
		z-index: 3;
		transform: rotate(0deg);
	}
	.fard__page--1 {
		z-index: 2;
		transform: rotate(-4deg) translateY(-2%);
		filter: brightness(0.92);
	}
	.fard__page--2 {
		z-index: 1;
		transform: rotate(-8deg) translateY(-4%);
		filter: brightness(0.84);
	}
	/* //? Le dossier s'ouvre au survol : les pages se mettent en éventail. */
	.post-card[data-fard]:hover .fard__page--1,
	.post-card[data-fard]:focus-within .fard__page--1 {
		transform: rotate(-8deg) translateY(-3%);
	}
	.post-card[data-fard]:hover .fard__page--2,
	.post-card[data-fard]:focus-within .fard__page--2 {
		transform: rotate(-15deg) translateY(-6%);
	}
	/* //? Pastille « à venir » : en haut à GAUCHE, juste sous la bande de titre — l'autre coin bas-droit est pris par
		? le compteur de pages du fard. Contour plutôt qu'aplat, pour ne pas se confondre avec ce compteur ; fond plein
		? pour rester lisible sur l'image. Même plan que le titre (z 5), donc au-dessus des pages dépliées. */
	.post-card__scheduled {
		position: absolute;
		top: calc(16% + 0.5rem);
		left: 0.5rem;
		z-index: 6;
		padding: 0.15em 0.5em;
		border: 1px solid var(--acc-text);
		border-radius: 6px;
		background: var(--bg);
		color: var(--acc-text);
		font-family: var(--font-mono, monospace);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		/* //? Toujours dans le DOM, affichée seulement pour un post encore à paraître. C'est
			? `initSchedule` qui pose `data-scheduled` à l'heure du NAVIGATEUR ; `display:none`
			? l'exclut aussi de l'arbre a11y, donc le nom accessible du lien reste juste. */
		display: none;
	}
	.post-card[data-scheduled] .post-card__scheduled {
		display: block;
	}
	.fard__badge {
		position: absolute;
		right: 0.5rem;
		bottom: 0.5rem;
		z-index: 4;
		padding: 0.15em 0.45em;
		border-radius: 6px;
		font-family: var(--font-mono, monospace);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		background: var(--acc);
		color: var(--acc-ink);
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card {
			transition: none;
		}
		.post-card:hover,
		.post-card:focus-within {
			transform: none;
		}
		.fard__page {
			transition: none;
		}
	}
</style>
