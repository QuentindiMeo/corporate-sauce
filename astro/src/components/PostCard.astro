---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Post } from '@domain/post';
import { styleFromMode } from '@/ui/theme/modes';

interface Props {
	post: Post;
	/** `true` pour le 1er écran (désactive le lazy-load, améliore le LCP). */
	prioritaire?: boolean;
}

const { post, prioritaire = false } = Astro.props;

// L'entité expose `image` en `PostImage` ; à l'exécution c'est l'`ImageMetadata`
// d'Astro (voir infrastructure). On restaure le type pour le composant <Image>.
const image = post.image as unknown as ImageMetadata;
---

<article class="post-card" data-mode={post.mode} style={styleFromMode(post.mode)}>
	<a
		class="post-card__link"
		href={post.lienLinkedIn}
		target="_blank"
		rel="noopener noreferrer"
		data-post-id={post.id}
		aria-label={`Ouvrir le post « ${post.titre} » (rubrique ${post.rubrique})`}
	>
		<p class="post-card__titre"><span>{post.titre}</span></p>
		<Image
			class="post-card__image"
			src={image}
			alt={post.imageAlt}
			widths={[360, 540, 720]}
			sizes="(max-width: 640px) 80vw, 260px"
			loading={prioritaire ? 'eager' : 'lazy'}
		/>
	</a>
</article>

<style>
	.post-card {
		position: relative;
		border-radius: 10px;
		overflow: hidden;
		background: var(--bg);
		/* Couleur du texte = --fg DU MODE (posé en inline par styleFromMode), pas
		   celui du chrome : sans ça, un titre pouvait tomber à ~1:1 (ex. crème sur
		   crème). Ainsi le contraste titre/fond reste ≥ 14:1 dans les 3 modes. */
		color: var(--fg);
		border: 1px solid var(--border);
		/* Animation progressive (charte) : profondeur au survol. */
		transition:
			transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.35s ease;
	}
	.post-card:hover,
	.post-card:focus-within {
		transform: scale(1.06) rotate(-1.5deg);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
		z-index: 2;
	}
	.post-card__link {
		display: flex;
		flex-direction: column;
		aspect-ratio: 1 / 1;
		text-decoration: none;
		color: inherit;
	}
	.post-card__link:hover,
	.post-card__link:focus {
		text-decoration: revert;
	}
	.post-card__titre {
		height: 20%;
		margin: 0;
		padding: 0 0.75rem;
		/* Centrage vertical + horizontal du titre dans la bande (1 ou 2 lignes). */
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-title, system-ui, sans-serif);
		font-weight: 700;
		font-size: 0.95rem;
		line-height: 1.2;
	}
	/* Le clamp 2 lignes vit sur l'enfant, sans interférer avec le centrage. */
	.post-card__titre span {
		text-align: center;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-card__image {
		display: block;
		width: 100%;
		/* Remplit tout l'espace sous le titre pour que le lien reste carré ;
		   recadrage centré sur le HAUT de l'image (le bas est rogné). */
		flex: 1;
		min-height: 0;
		object-fit: cover;
		object-position: top;
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card {
			transition: none;
		}
		.post-card:hover,
		.post-card:focus-within {
			transform: none;
		}
	}
</style>
