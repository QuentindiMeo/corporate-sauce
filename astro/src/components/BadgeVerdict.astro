---
interface Props {
	type: 'ok' | 'bad';
}

const { type } = Astro.props;
const glyphe = type === 'ok' ? '✓' : '✕';
const libelle = type === 'ok' ? 'Bonne pratique' : 'À éviter';
---

<span class={`badge-verdict badge-verdict--${type}`} role="img" aria-label={libelle}>
	<span aria-hidden="true">{glyphe}</span>
</span>

<style>
	/* Charte §5 : cercle 44×44 px, glyphe 22 px blanc. Toujours ces dimensions. */
	.badge-verdict {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		font-size: 22px;
		line-height: 1;
		color: #fff;
	}
	.badge-verdict--ok {
		background: var(--ok, #2e6a46);
	}
	.badge-verdict--bad {
		background: var(--bad, #b23415);
	}
</style>
