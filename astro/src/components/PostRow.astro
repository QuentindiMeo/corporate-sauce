---
import type { ThemeRow } from '@domain/post-collection';
import PostCard from './PostCard.astro';
import TagCategory from './TagCategory.astro';

interface Props {
	row: ThemeRow;
	/** `true` pour la première ligne : ses visuels sont prioritaires (LCP). */
	priority?: boolean;
}

const { row, priority = false } = Astro.props;
const titleId = `category-${row.category.toLowerCase()}`;
---

<section class="post-row" aria-labelledby={titleId}>
	<h2 id={titleId} class="post-row__title">
		<TagCategory category={row.category} />
	</h2>
	<ul class="post-row__track">
		{
			row.posts.map((post, i) => (
				<li class="post-row__item">
					<PostCard post={post} priority={priority && i === 0} />
				</li>
			))
		}
	</ul>
</section>

<style>
	.post-row {
		margin-block: 1rem;
	}
	.post-row__title {
		margin-bottom: 0.5rem;
		scroll-margin-top: 4rem;
	}
	/* Mobile : piste défilable horizontalement. Desktop : grille de 4. */
	.post-row__track {
		list-style: none;
		margin: 0;
		padding: 0 0 0.5rem;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(200px, 60vw);
		/* Ratios natifs variables → on aligne en haut plutôt que d'étirer les cartes. */
		align-items: start;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
	}
	.post-row__item {
		scroll-snap-align: start;
	}
	@media (min-width: 768px) {
		.post-row__track {
			grid-auto-flow: row;
			grid-template-columns: repeat(4, 1fr);
			grid-auto-columns: unset;
			overflow-x: visible;
		}
	}
</style>
