---
import type { ThemeRow } from '@domain/post-collection';
import PostTrack from './PostTrack.astro';
import TagCategory from './TagCategory.astro';

interface Props {
	row: ThemeRow;
	/** `true` pour la première ligne : ses visuels sont prioritaires (LCP). */
	priority?: boolean;
}

const { row, priority = false } = Astro.props;
const titleId = `category-${row.category.toLowerCase()}`;
---

<section class="post-row" aria-labelledby={titleId}>
	<h2 id={titleId} class="post-row__title">
		<TagCategory category={row.category} />
	</h2>
	<PostTrack posts={row.posts} priority={priority} />
</section>

<style>
	.post-row {
		margin-block: 1rem;
	}
	.post-row__title {
		margin-bottom: 0.5rem;
		scroll-margin-top: 4rem;
	}
</style>
