---
import type { LigneThematique } from '@domain/post-collection';
import PostCard from './PostCard.astro';
import TagRubrique from './TagRubrique.astro';

interface Props {
	ligne: LigneThematique;
	/** `true` pour la première ligne : ses visuels sont prioritaires (LCP). */
	prioritaire?: boolean;
}

const { ligne, prioritaire = false } = Astro.props;
const titreId = `rubrique-${ligne.rubrique.toLowerCase()}`;
---

<section class="post-row" aria-labelledby={titreId}>
	<h2 id={titreId} class="post-row__titre">
		<TagRubrique rubrique={ligne.rubrique} />
	</h2>
	<ul class="post-row__piste">
		{
			ligne.posts.map((post, i) => (
				<li class="post-row__item">
					<PostCard post={post} prioritaire={prioritaire && i === 0} />
				</li>
			))
		}
	</ul>
</section>

<style>
	.post-row {
		margin-block: 2.5rem;
	}
	.post-row__titre {
		margin-bottom: 1rem;
	}
	/* Mobile : piste défilable horizontalement. Desktop : grille de 4. */
	.post-row__piste {
		list-style: none;
		margin: 0;
		padding: 0 0 0.5rem;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(200px, 60vw);
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
	}
	.post-row__item {
		scroll-snap-align: start;
	}
	@media (min-width: 768px) {
		.post-row__piste {
			grid-auto-flow: row;
			grid-template-columns: repeat(4, 1fr);
			grid-auto-columns: unset;
			overflow-x: visible;
		}
	}
</style>
