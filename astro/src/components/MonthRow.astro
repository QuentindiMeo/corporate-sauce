---
import type { MonthRowViewModel } from '@/ui/view-model/post-view-model';
import PostTrack from './PostTrack.astro';

interface Props {
	row: MonthRowViewModel;
	priority?: boolean;	// ? `true` pour le premier mois du flux : ses visuels sont prioritaires (LCP).
}

const { row, priority = false } = Astro.props;
const titleId = `month-${row.monthKey}`;
---

<section class="month-row" aria-labelledby={titleId}>
	<h2 id={titleId} class="month-row__title">
		<!-- ? `datetime` porte la clé UTC AAAA-MM : le mois reste lisible par la machine même si le libellé, lui, est localisé en français. -->
		<time class="month-row__label" datetime={row.monthKey}>{row.label}</time>
		<span class="month-row__count">{row.count} post{row.count > 1 ? 's' : ''}</span>
	</h2>
	<PostTrack posts={row.posts} priority={priority} />
</section>

<style>
	.month-row {
		margin-block: 1rem;
	}
	.month-row__title {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
		scroll-margin-top: 4rem;
	}
	/*// ? Même pose que TagCategory (charte §5) : mono 800, MAJUSCULES, filet 2px, radius 7px — le flux chronologique et la vue thématique se répondent. */
	.month-row__label {
		font-family: var(--font-mono, monospace);
		font-weight: 800;
		font-size: 20px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.15em 0.5em;
		border: 2px solid var(--acc-text, var(--acc));
		border-radius: 7px;
		color: var(--acc-text, var(--acc));
	}
	.month-row__count {
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
</style>
