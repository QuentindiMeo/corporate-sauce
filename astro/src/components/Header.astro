---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="chevron">›</span>{SITE_TITLE}<span class="cursor" aria-hidden="true"></span>
		</a>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		padding: 1rem 1.5rem;
		border-bottom: 1px solid var(--border, #331c14);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		font-family: var(--font-mono, monospace);
		font-weight: 800;
		text-decoration: none;
		color: inherit;
	}
	.chevron {
		opacity: 0.6;
		margin-right: 0.25em;
	}
	.cursor {
		display: inline-block;
		width: 0.5em;
		height: 1.5em;
		margin-left: 0.15em;
		background: currentColor;
		vertical-align: text-bottom;
		/* Clignotement type terminal : 1 s, net (pas de fondu). */
		animation: cursor-blink 1s step-end infinite;
	}

	@keyframes cursor-blink {
		0% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
		100% {
			opacity: 1;
		}
	}
</style>
