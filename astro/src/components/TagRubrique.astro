---
import type { Rubrique } from '@domain/rubrique';

interface Props {
	rubrique: Rubrique;
}

const { rubrique } = Astro.props;
---

<span class="tag-rubrique">{rubrique}</span>

<style>
	/* Charte §5 : border 2px, mono 800, 20px, MAJUSCULES, radius 7px. */
	.tag-rubrique {
		display: inline-block;
		font-family: var(--font-mono, monospace);
		font-weight: 800;
		font-size: 20px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.15em 0.5em;
		border: 2px solid var(--acc-text, var(--cool-text, currentColor));
		border-radius: 7px;
		color: var(--acc-text, var(--cool-text, currentColor));
	}
</style>
