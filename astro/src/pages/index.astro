---
import { listPostsByTheme } from '@application/list-posts-by-theme';
import { astroPostRepository } from '@infrastructure/content/astro-post-repository';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostGrid from '../components/PostGrid.astro';
import PostModal from '../components/PostModal.astro';
import { galleryJsonLd } from '@/ui/seo/structured-data';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Hexagone : adaptateur infra → cas d'usage → domaine → grille.
const rows = await listPostsByTheme(astroPostRepository);
const posts = rows.flatMap((row) => row.posts);
const total = posts.length;

const jsonLd = galleryJsonLd({
	siteUrl: Astro.site?.href ?? Astro.url.origin,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	posts,
});
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<Header />
		<main id="contenu">
			<header class="intro">
				<h1>{SITE_TITLE}</h1>
				<p class="intro__subtitle">
					Une pratique du logiciel, un visuel à la fois. {total} posts, {rows.length} rubriques.
				</p>
			</header>

			<PostGrid rows={rows} />
		</main>
		<PostModal posts={posts} />
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 72rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}
	.intro {
		margin-block: 1rem 2rem;
	}
	h1 {
		font-size: clamp(2rem, 5vw, 3.25rem);
	}
	.intro__subtitle {
		margin-top: 0.75rem;
		max-width: 44ch;
		color: var(--muted);
		font-family: var(--font-mono, monospace);
	}
</style>
