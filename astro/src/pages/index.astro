---
import { listPostsByTheme } from '@application/list-posts-by-theme';
import { astroPostRepository } from '@infrastructure/content/astro-post-repository';
import BaseHead from '../components/BaseHead.astro';
import CategoryNav from '../components/CategoryNav.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostGrid from '../components/PostGrid.astro';
import PostModal from '../components/PostModal.astro';
import { galleryJsonLd } from '@/ui/seo/structured-data';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Hexagone : adaptateur infra → cas d'usage → domaine → grille.
const rows = await listPostsByTheme(astroPostRepository);
const categories = rows.map((row) => row.category);
const posts = rows.flatMap((row) => row.posts);
const total = posts.length;

const jsonLd = galleryJsonLd({
	siteUrl: Astro.site?.href ?? Astro.url.origin,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	posts,
});
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<Header />
		<CategoryNav categories={categories} />
		<main id="contenu">
			<header class="intro">
				<h1>{SITE_TITLE}</h1>
				<p class="intro__subtitle">
					Secrets de fabrication logicielle et tuyaux en tout genre.<br/>Une conviction par visuel, sans détour.
				</p>
				<p class="intro__meta">{total} posts · {rows.length} rubriques</p>
			</header>

			<PostGrid rows={rows} />
		</main>
		<PostModal posts={posts} />
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 72rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}
	.intro {
		margin-block: 1rem 2rem;
	}
	h1 {
		font-size: clamp(2rem, 5vw, 3.25rem);
	}
	.intro__subtitle {
		margin-top: 0.75rem;
		max-width: 60%;
		font-family: var(--font-title, system-ui, sans-serif);
		font-size: clamp(1.05rem, 2.2vw, 1.4rem);
		font-weight: 500;
		line-height: 1.25;
		color: var(--fg);
		text-wrap: balance;
	}
	.intro__meta {
		margin-top: 0.75rem;
		font-family: var(--font-mono, monospace);
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
</style>
