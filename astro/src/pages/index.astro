---
import { listerPostsParTheme } from '@application/lister-posts-par-theme';
import { astroPostRepository } from '@infrastructure/content/astro-post-repository';
import { styleFromMode } from '@/ui/theme/modes';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TagRubrique from '../components/TagRubrique.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Traversée end-to-end de l'hexagone : adaptateur infra → cas d'usage → domaine.
// Rendu volontairement simple — la grille interactive arrive en Phase 3.
const lignes = await listerPostsParTheme(astroPostRepository);
const total = lignes.reduce((n, ligne) => n + ligne.posts.length, 0);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<Header />
		<main id="contenu">
			<h1>{SITE_TITLE}</h1>
			<p class="compteur">{total} posts · {lignes.length} rubriques.</p>

			{
				lignes.map((ligne) => (
					<section class="ligne">
						<TagRubrique rubrique={ligne.rubrique} />
						<ul>
							{ligne.posts.map((post) => (
								<li class="post" data-mode={post.mode} style={styleFromMode(post.mode)}>
									<a href={post.lienLinkedIn} target="_blank" rel="noopener noreferrer">
										{post.titre}
									</a>
									<span class="post__mode">{post.mode}</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 60rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}
	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
	}
	.compteur {
		color: var(--muted);
		font-family: var(--font-mono, monospace);
		margin: 0.5rem 0 2rem;
	}
	.ligne {
		margin-block: 2rem;
	}
	.ligne ul {
		list-style: none;
		padding: 0;
		margin-top: 0.75rem;
		display: grid;
		gap: 0.5rem;
	}
	.post {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 0.9rem;
		border-left: 4px solid var(--acc);
		background: var(--panel, transparent);
	}
	.post__mode {
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		color: var(--muted);
		text-transform: uppercase;
	}
</style>
